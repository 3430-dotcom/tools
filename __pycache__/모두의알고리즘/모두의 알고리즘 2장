# 문제 4-펙토리얼 구하기
# 1
def fanc(n):
    a = 1
    for i in range(1, n+1):
        a *= i
    return a
# 재귀호출 사용
def fan(n):
    if n <= 1:
        return 1
    return n*fan(n-1)
# 연습문제 
# 1. 1부터 n 까지의 합 -> 재귀호출
def findsum(n):
    if n == 0:
        return 0
    return n + findsum(n-1)
# 2. 숫자 n 개 중 최댓값 찾기->>>>모르겠어...
def findmaxr(num, n):
    if n == 1:
        return num[0]
    max_num = findmaxr(num, n-1)
    if max_num > num[n-1]:
        return max_num
    else:
        return num[n-1]

# 5장 최대공약수 구하기
# 1-> 이상한방법
def gcd(a, b):
    an = 1
    result = []
    while a>=an and b>=an:
        if a%an == b%an == 0:
            result.append(an)
        an += 1
    result = result.sorted()
    return result[-1]
# 정석
def find_gcd(a, b):
    i = min(a, b)
    while True:
        if a%i == 0 and b%i == 0:
            return i
        i -= 1
# 유클리드 호제법 이용
def gcd_euclid(a, b):
    if b == 0:
        return a
    return gcd_euclid(b, a%b)
# 연습문제
# 1. 피보나치수 구하기
def fibonacci(n):
    if n == 1:
        return 0
    elif n == 2:
        return 1
    return fibonacci(n-1) + fibonacci(n-2)
